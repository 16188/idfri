{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IDFRI",
  "version": "0.1.0-beta.50",
  "identifier": "com.idfri.desktop",
  "build": {
    "frontendDist": "bootstrap"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/idfri-sidecar", "binaries/idfri-mcp"],
    "resources": {
      "resources/chromium/": "chromium/",
      "resources/firefox/": "firefox/",
      "resources/playwright/": "playwright/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "compression": "zlib",
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk2NzdFRjczNTNFMEM4QUUKUldTdXlPQlRjKzkzbGg3bzgweXRYRVRkZHNwMW5xMnhsNDNKbHRIZ1NrMWZ2WTd4eklzcmYybDIK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
